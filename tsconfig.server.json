{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-server",
    "rootDir": "src",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/main/db/**/*.ts",
    "src/main/services/**/*.ts",
    "src/main/utils/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
